# Generated by scripts/deploy_fly.py. Edit the template in deploy/, not fly.toml.
app = "{app}"
primary_region = "{region}"

[build]
  dockerfile = "Dockerfile"

[env]
  PUBLIC_BASE_URL = "https://{app}.fly.dev"
  DATA_DIR = "/data"
  CAMPAIGN_DIR = "/app/campaigns"
  TWILIO_VALIDATE_SIGNATURE = "true"

# One machine that never sleeps: Twilio webhooks must answer in seconds, and the dialer lives in memory.
[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type = "connections"
    soft_limit = 50
    hard_limit = 80

  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    timeout = "5s"
    method = "GET"
    path = "/health"

[mounts]
  source = "data"
  destination = "/data"

[[vm]]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1

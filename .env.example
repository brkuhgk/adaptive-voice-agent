# Copy to .env and fill in. Never commit .env.

# ---------- LLM (pick one provider) ----------
# foundry = Microsoft Foundry / Azure OpenAI (use Azure for Students credit)
# github  = GitHub Models (free, rate-limited; same Foundry model catalog, great for dev)
# openai  = OpenAI directly
LLM_PROVIDER=foundry
# Foundry: copy from your resource's Keys and Endpoint page.
# Foundry only (must end with /openai/v1/). Leave EMPTY for github or openai.
LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# Foundry API key, or a GitHub fine-grained token with "Models: read", or an OpenAI key
LLM_API_KEY=
# Foundry: your *deployment* name (deploy gpt-4.1-mini). GitHub: openai/gpt-4.1-mini
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.6
# Parallel state-tracker call per turn. Set false to halve LLM calls on tight rate limits.
STATE_TRACKER_ENABLED=true

# ---------- Deepgram (speech-to-text) ----------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# ms of silence that ends a caller turn. Raise to 500-600 if callers get cut off mid-sentence.
DEEPGRAM_ENDPOINTING_MS=400

# ---------- ElevenLabs (text-to-speech) ----------
ELEVENLABS_API_KEY=
# "Sarah". Run: python -m scripts.check_setup --voices   to list voices you can use
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------- Twilio (phone) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Reject webhooks that aren't signed by Twilio (turn on once PUBLIC_BASE_URL is stable)
TWILIO_VALIDATE_SIGNATURE=false
# Single test calls (POST /api/call) only go to these numbers. Campaigns use the consent column instead.
OUTBOUND_ALLOWLIST=

# ---------- Supabase (optional) ----------
# Contacts from the signup_requests table, and every call saved to call_conversations (supabase/schema.sql).
# Supabase -> Project Settings -> API. Use the service_role (or sb_secret_) key: server only, never in a browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Server ----------
# Your public https tunnel URL (ngrok / cloudflared), no trailing slash
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
SCENARIO=clinic
# Any long random string; signs each media stream so randoms can't connect to it
STREAM_SECRET=replace-with-a-long-random-string
# Optional: require ?token=... for the dashboard, campaigns API and text-mode API
DASHBOARD_TOKEN=
# Optional: where scripts/campaign.py finds the running server (start/stop/status)
SERVER_URL=http://localhost:8000

# ---------- Conversation tuning ----------
BARGE_IN_MIN_CHARS=4
SILENCE_TIMEOUT_S=9
